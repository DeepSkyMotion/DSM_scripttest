<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>DSM Test - PixInsight scripts by DeepSkyMotion.</p>
   </description>
   <platform os="all" arch="noarch" version="1.9.4:1.9.99">
      <package fileName="FlatStrengthCalibration_v6.zip" sha1="29aaba49cc7f554033c55e8a53580fca3a675796" type="script" releaseDate="20261127">
         <title>Flat Strength Calibration v6</title>
         <description>
            <p>Calibrates lights with per-session flats at an adjustable flat strength; v6 fixes the dark/bias help text, removes dark optimization, keeps zero flat pixels at zero and integrates CFA flats per channel.</p>
            <p>Menu: Script &gt; DSM Test &gt; Flat Strength Calibration v6.</p>
         </description>
      </package>
      <package fileName="SmartFrameSelection_v4.zip" sha1="22449eb61ab7fa2877c48fa4dca32ac9aede6014" type="script" releaseDate="20261127">
         <title>Smart Frame Selection v4</title>
         <description>
            <p>Measures subframes in a central ROI with SubframeSelector and selects the best frames; v4 keeps the report on export failures, keeps the copy-unchanged choice and refuses mixed frame groups.</p>
            <p>Menu: Script &gt; DSM Test &gt; Smart Frame Selection v4.</p>
         </description>
      </package>
      <package fileName="SyntheticLight_retired.zip" sha1="2cc2be91582519350a4ec23fa8e9721a923eb27f" type="script" releaseDate="20261127">
         <title>SyntheticLight (development versions retired)</title>
         <remove>src/scripts/DSMTest/SyntheticLight_v1/
src/scripts/DSMTest/SyntheticLight_v2/
src/scripts/DSMTest/SyntheticLight_v3/
src/scripts/DSMTest/SyntheticLight_v4/
src/scripts/DSMTest/SyntheticLight_v5/
src/scripts/DSMTest/SyntheticLight_v6/</remove>
         <description>
            <p>Removes the development versions of SyntheticLight from this PixInsight installation.</p>
         </description>
      </package>
   </platform>
</xri>
