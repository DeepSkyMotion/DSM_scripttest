<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>DSM Test - development builds of DeepSkyMotion PixInsight scripts. Work in progress, not for general use.</p>
   </description>
   <platform os="all" arch="noarch" version="1.9.4:1.9.99">
      <package fileName="SyntheticLight_retired.zip" sha1="ab487be7b3a616de0d9a0f2f2a17e82525957494" type="script" releaseDate="20261110">
         <title>SyntheticLight (development versions retired)</title>
         <remove>src/scripts/DSMTest/SyntheticLight_v1/
src/scripts/DSMTest/SyntheticLight_v2/
src/scripts/DSMTest/SyntheticLight_v3/</remove>
         <description>
            <p>Removes the development versions of SyntheticLight from this PixInsight installation.</p>
         </description>
      </package>
      <package fileName="RingArtifactRemover_v2.zip" sha1="848b4c1f55019f9f0e1373a244e816004d6fd845" type="script" releaseDate="20261115">
         <title>Ring Artifact Remover v2</title>
         <description>
            <p>Removes large-scale ring artifacts from internal reflections with a locally adaptive polar model that follows each ring's own shape.</p>
            <p>Menu: Script &gt; DSM Test &gt; Ring Artifact Remover v2.</p>
         </description>
      </package>
   </platform>
</xri>
