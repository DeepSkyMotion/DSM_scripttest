<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>DSM Test - development builds of DeepSkyMotion PixInsight scripts. Work in progress, not for general use.</p>
   </description>
   <platform os="all" arch="noarch" version="1.9.4:1.9.99">
      <package fileName="RingArtifactRemover_v2.zip" sha1="848b4c1f55019f9f0e1373a244e816004d6fd845" type="script" releaseDate="20261115">
         <title>Ring Artifact Remover v2</title>
         <description>
            <p>Removes large-scale ring artifacts from internal reflections with a locally adaptive polar model that follows each ring's own shape.</p>
            <p>Menu: Script &gt; DSM Test &gt; Ring Artifact Remover v2.</p>
         </description>
      </package>
      <package fileName="FlatStrengthCalibration_v1.zip" sha1="1428ec549d7c354fb6a4db383b780a3814e6dc82" type="script" releaseDate="20261116">
         <title>Flat Strength Calibration v1</title>
         <description>
            <p>Calibrates lights per session with master darks and a self-built master flat, with an adjustable flat-correction strength (-1..+1) previewed before/after with auto stretch.</p>
            <p>Menu: Script &gt; DSM Test &gt; Flat Strength Calibration v1.</p>
         </description>
      </package>
      <package fileName="FlatStrengthCalibration_v2.zip" sha1="d604190e7beaf319b4302f34bb1528296b1b889c" type="script" releaseDate="20261116">
         <title>Flat Strength Calibration v2</title>
         <description>
            <p>Calibrates lights per session with master darks and a self-built master flat, with an adjustable flat-correction strength (-1..+1) previewed before/after with linked or unlinked auto stretch.</p>
            <p>Menu: Script &gt; DSM Test &gt; Flat Strength Calibration v2.</p>
         </description>
      </package>
      <package fileName="SyntheticLight_retired.zip" sha1="3383a262d2a10a1952c289f896486ed89b1d2d1a" type="script" releaseDate="20261121">
         <title>SyntheticLight (development versions retired)</title>
         <remove>src/scripts/DSMTest/SyntheticLight_v1/
src/scripts/DSMTest/SyntheticLight_v2/
src/scripts/DSMTest/SyntheticLight_v3/
src/scripts/DSMTest/SyntheticLight_v4/
src/scripts/DSMTest/SyntheticLight_v5/</remove>
         <description>
            <p>Removes the development versions of SyntheticLight from this PixInsight installation.</p>
         </description>
      </package>
      <package fileName="SmartFrameSelection_retired.zip" sha1="9db2e186953294e03b26e4b14cba37a05a86d358" type="script" releaseDate="20261124">
         <title>SmartFrameSelection (development versions retired)</title>
         <remove>src/scripts/DSMTest/SmartFrameSelection_v1/
src/scripts/DSMTest/SmartFrameSelection_v2/
src/scripts/DSMTest/SmartFrameSelection_v3/</remove>
         <description>
            <p>Removes the development versions of SmartFrameSelection from this PixInsight installation.</p>
         </description>
      </package>
   </platform>
</xri>
