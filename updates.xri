<?xml version="1.0" encoding="UTF-8"?>
<xri version="1.0">
   <description>
      <p>DSM Test - development builds of DeepSkyMotion PixInsight scripts. Work in progress, not for general use.</p>
   </description>
   <platform os="all" arch="noarch" version="1.9.4:1.9.99">
      <package fileName="SyntheticLight_v1.zip" sha1="15fdd8eec57f44d831f73ab57470cbdb19ed5e00" type="script" releaseDate="20261110">
         <title>Synthetic Light v1</title>
         <description>
            <p>Builds a synthetic monochrome luminance (Synthetic Light) from an RGB image or separate R, G, B masters using CFA, Rec.709 or custom weights, with optional background/scale normalization.</p>
            <p>Menu: Script &gt; DSM Test &gt; Synthetic Light v1.</p>
         </description>
      </package>
      <package fileName="SyntheticLight_v2.zip" sha1="45ccfe917549aeb98dd662bd0f6c99e785f969de" type="script" releaseDate="20261110">
         <title>Synthetic Light v2</title>
         <description>
            <p>Builds a synthetic monochrome luminance (Synthetic Light) from an RGB image or separate R, G, B masters using CFA, Rec.709 or custom weights, with optional background/scale normalization. v2 adds detailed tooltips with usage recommendations.</p>
            <p>Menu: Script &gt; DSM Test &gt; Synthetic Light v2.</p>
         </description>
      </package>
      <package fileName="SyntheticLight_v3.zip" sha1="d2329b6d383a556afe220084037cae308f180660" type="script" releaseDate="20261110">
         <title>Synthetic Light v3</title>
         <description>
            <p>Builds a synthetic monochrome luminance (Synthetic Light) from an RGB image or separate registered R, G, B masters using CFA, Rec.709 or custom weights, with optional background/scale normalization and a live auto-stretched preview.</p>
            <p>Menu: Script &gt; DSM Test &gt; Synthetic Light v3.</p>
         </description>
      </package>
   </platform>
</xri>
